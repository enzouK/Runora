{
  "name": "react-example",
  "private": true,
  "version": "0.1.0",
  "description": "Anki 2.0 style flashcards with FSRS scheduler",
  "author": "enzouK <enzouk@users.noreply.github.com>",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "app": "node electron/dev.cjs",
    "app:build": "npm run build && electron-builder --win",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "android:build": "npm run build && npx cap copy android && npx cap build android",
    "android:open": "npx cap open android",
    "android:run": "npm run build && npx cap copy android && npx cap run android"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.enzouk.anki2fsrs",
    "productName": "Anki 2.0 FSRS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "fzstd": "^0.1.1",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sql.js": "^1.14.2",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^44.10.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.0",
    "playwright": "^1.64.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
