# Environment variables for Runora

# FSRS Parameters
# LR: Initial decay rate (default: 0.5)
# LAP: Learning interval parameter (default: 15)
# MW: Memory width parameter (default: 20)
# RS: Retrieval strength parameters
FRS_LR="0.5"
FRS_LAP="15"
FRS_MW="20"

# Anki Connect API
ANKI_CONNECT_URL="http://localhost:8765"

# Application Settings
APP_NAME="Runora"
